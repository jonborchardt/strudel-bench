// held: a slow chamber piece in D dorian at 65 bpm. Deep low end in three stages (a sawtooth sub down at d1 under an
// arco contrabass under the cello), piano, violin and flute over it, and a string bed that opens in the climax.
// The cello, violin, flute, contrabass and strings are real layers, so they have knobs, a sound pick and a notes box in
// the mixer and they all share one reverb bus. Only the sub and the piano are raw, because both have to hold a note the
// layers cannot: seven raw parts meant seven convolvers of a 3.2 s hall and the climax traced 59% busy with dropouts.
const played = { timingMs: 14, velocity: .08, correlation: 'phrase' };
const swelled = { timingMs: 22, velocity: .06, correlation: 'bar' };
// the rumble: a sawtooth on the chord root in octave 1 (d1 is 37 Hz) held the whole bar, lowpassed to 160 Hz so the
// fundamental and the first three harmonics (37, 73, 110, 147 Hz) come through and nothing above them does. A sine down
// there is felt by a subwoofer and heard by nothing else; the harmonics are what a speaker actually rumbles with.
// It is a raw part because the bass layer's hap is one grid step (0.24 s here) and a drone has to hold the bar.
const SUB = 'd1 g1 c1 f1 d1 g1 c1 f1';
const sub = (line, o = {}) => ({ pattern: note('<' + line + '>').s('sawtooth').lpf(160).clip(1.02), level: .85, space: .35, humanize: swelled, ...o });
// arco contrabass an octave over the sub, the attack a sawtooth has none of: a pad at one tone is the chord root held
// with a 1.7 s release, which is what arco means, and unlike the bass layer it sustains
const bass = { sound: 'gm_contrabass', density: .25, register: .3, weight: .8, brightness: .5, articulation: .1, space: .45, width: .5, level: 1.1, humanize: swelled };
// the cello is the voice of the low end, not a root machine: a written line in octave 3, negative degrees reaching under it
const cello = { sound: 'gm_cello', register: .2, brightness: .55, articulation: .15, space: .5, level: 1.3, position: -.15, humanize: played };
const violin = { sound: 'gm_violin', register: .5, brightness: .6, articulation: .15, space: .45, level: 1.5, position: .25, humanize: played };
const flute = { sound: 'gm_flute', register: .8, brightness: .55, articulation: .2, space: .6, level: 1, position: .35, humanize: played };
// the string bed only opens in the climax: low voicing, slow swell, wide. This is the part that does the holding.
const strings = { sound: 'gm_string_ensemble_1', register: .3, density: .75, brightness: .45, articulation: .1, space: .6, width: .7, level: .8, humanize: swelled };

// the piano's own voicing, one bar per group: left hand, then the chord held under the pedal (clip 1.7)
const G = (line, o = {}) => ({ pattern: note('<' + line + '>').s('piano').clip(1.7), level: .6, position: -.25, space: .55, humanize: { ...played, correlation: 'bar' }, ...o });
const PIANO = '[d2 [a2,d3,f3]@3] [g2 [d3,g3,b3]@3] [c2 [g2,c3,e3]@3] [f2 [c3,f3,a3]@3]';
const PIANO2 = '[d2 [a2,d3,f3]@2 a3] [g2 [d3,g3,b3]@2 d4] [c2 [g2,c3,e3]@2 g3] [f2 [c3,f3,a3]@2 c4]';
const PIANO3 = '[d2 [a2,d3,f3]@2 [a3,d4]] [g2 [d3,g3,b3]@2 [b3,d4]] [c2 [g2,c3,e3]@2 [e4,g4]] [f2 [c3,f3,a3]@2 [a3,f4]]';
const WARM = 'i IV VII III';

song({ cps: .27, key: 'D:dorian', seed: 7, packs: ['rooms'], room: { ir: 'hall', size: 3.2, damping: 4500 } }, [

  section('open', 8, { role: 'establish', progression: WARM,
    raw:    sub(SUB),
    pad:    bass,
    // the cello states the tune the violin will take over: down a step, a rest low, a held sixth, home
    melody: { ...cello, phrase: 8, notes: '[0@3 -1] -2 [1@2 3@2] [2@3 -3] [0@2 2@2] [3@3 2] 1 [-1@2 -3@2]' },
    raw2:   G(PIANO + ' ' + PIANO),
  }),

  section('lift', 8, { role: 'develop', progression: WARM,
    raw:    sub(SUB),
    pad:    bass,
    melody: { ...cello, phrase: 8, notes: '[0@2 1@2] [-2@3 0] [1@4] [2@2 -1@2] [-3@3 0] [3@2 -2@2] [1@3 3] [-3@4]' },
    // the violin takes the tune: root, step up, a held fourth, a leap to the octave, and home
    melody2: { ...violin, phrase: 8, velocity: '.8 .95 .85 1 .9 1 .85 .9',
               notes: '[0@2 1 2] [3@3 ~] [1@2 3 4] 2 [4@2 ~ 7] [7@3 6] [4@2 3 2] [1@2 0@2]' },
    // the flute answers only in the bars the violin leaves open
    melody3: { ...flute, phrase: 8, notes: '~ [~@2 0@2] ~ [~@2 -1 -3] ~ [~@3 -3] ~ [2@2 1@2]' },
    raw2:   G(PIANO2 + ' ' + PIANO2),
  }),

  section('hold', 8, { role: 'climax', progression: WARM,
    raw:    sub(SUB),
    pad:    bass,
    melody: { ...cello, phrase: 8, level: 1.4, notes: '[0@2 2@2] [3@3 0] [1@2 -1@2] [2@4] [4@2 2@2] [3@3 -2] [-1@2 1@2] [0@4]' },
    // the tune an octave up, wider intervals, the top note held over the chord change
    melody2: { ...violin, phrase: 8, level: 1.9, velocity: '.9 1 .95 1 1 1 .95 .9',
               notes: '[7@2 9@2] [10@3 7] [8@2 10@2] [9@4] [11@3 10] [7@2 9@2] [8@2 6@2] [7@4]' },
    // the flute sits a third under the violin, then goes above it
    melody3: { ...flute, phrase: 8, level: .9, notes: '[-3@4] [-2@3 ~] [-1@2 1@2] [-3@4] [~@2 6@2] [5@3 4] [3@2 ~@2] [4@2 7@2]' },
    pad2:   strings,
    raw2:   G(PIANO3 + ' ' + PIANO3),
  }),

  section('rest', 4, { role: 'release', progression: 'i III VII i',
    raw:    sub('d1 f1 c1 d1'),
    pad:    bass,
    // the cello has the last word: the opening phrase, slower, ending on the root
    melody: { ...cello, phrase: 4, notes: '[0@3 -1] [-3@4] [1@2 3@2] [0@4]' },
    raw2:   G('[d2 [a2,d3,f3]@3] [f2 [c3,f3,a3]@3] [c2 [g2,c3,e3]@3] [d2 [a2,d3,f3,d4]@3]'),
  }),
])
