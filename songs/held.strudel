// held: a slow chamber piece in D dorian at 65 bpm. Everything is a raw part (plain note().s()) so no synth attack or
// filter envelope lands on a bowed string or a struck piano. The low end is three deep layers, not one: a sine sub on
// the root, an arco contrabass on the root, and the cello singing a tenor line above them. One hall over the whole song.
// Four sections to settle the feel: piano and low strings alone, the violin enters with a flute answering in its rests,
// a climax where the string ensemble opens underneath, then everything drops back to piano and cello and lands home.
const played = { timingMs: 14, velocity: .08, correlation: 'phrase' };
const swelled = { timingMs: 22, velocity: .06, correlation: 'bar' };
// one bar per <> group, so every line below reads as eight bars of music
const part = (line, sound, { clip = 1.04, ...opts }) => ({ pattern: note('<' + line + '>').s(sound).clip(clip), ...opts });

// the deep: a sine on the chord root an octave under the contrabass. Felt, not heard.
const SUB = 'd1 g1 c1 f1 d1 g1 c1 f1';
const sub = (line) => part(line, 'sine', { level: .5, space: .3, brightness: .4, humanize: swelled });
// arco contrabass on the root, the attack the sine has none of
const BASS = 'd2 g2 c2 f2 d2 g2 c2 f2';
const BASS2 = '[d2@3 a1] [g2@3 d2] [c2@3 g1] [f2@3 c2] [d2@3 a1] [g2@3 d2] [c2@3 g2] [f2@2 g2@2]';
const bass = (line) => part(line, 'gm_contrabass', { level: .75, space: .4, brightness: .45, humanize: swelled });
// the cello is the voice of the low end: a written tenor line, never just roots
const cello = (line) => part(line, 'gm_cello', { level: .85, position: -.15, space: .55, brightness: .48, humanize: played });
// real sampled piano: left hand, then the chord held under the pedal
const piano = (line) => part(line, 'piano', { level: .55, position: -.25, space: .55, clip: 1.7, humanize: { ...played, correlation: 'bar' } });
const violin = (line, o) => part(line, 'gm_violin', { level: .8, position: .25, space: .6, brightness: .55, humanize: played, ...o });
const flute = (line, o) => part(line, 'gm_flute', { level: .7, position: .35, space: .7, brightness: .5, humanize: played, ...o });
// the string bed only opens in the climax: wide, far back, the thing that does the holding
const strings = (line) => part(line, 'gm_string_ensemble_1', { level: .6, width: .8, space: .85, brightness: .42, clip: 1.1, humanize: swelled });

const PIANO = '[d2 [a2,d3,f3]@3] [g2 [d3,g3,b3]@3] [c2 [g2,c3,e3]@3] [f2 [c3,f3,a3]@3]';
const PIANO2 = '[d2 [a2,d3,f3]@2 a3] [g2 [d3,g3,b3]@2 d4] [c2 [g2,c3,e3]@2 g3] [f2 [c3,f3,a3]@2 c4]';
const PIANO3 = '[d2 [a2,d3,f3]@2 [a3,d4]] [g2 [d3,g3,b3]@2 [b3,d4]] [c2 [g2,c3,e3]@2 [e4,g4]] [f2 [c3,f3,a3]@2 [a3,f4]]';
const PADS = '[d3,f3,a3] [d3,g3,b3] [e3,g3,c4] [f3,a3,c4]';
const WARM = 'i IV VII III';

song({ cps: .27, key: 'D:dorian', seed: 7, packs: ['rooms'], room: { ir: 'hall', size: 3.2, damping: 4500 } }, [

  section('open', 8, { role: 'establish', progression: WARM,
    raw:  sub(SUB),
    raw2: bass(BASS),
    // the cello states the tune the violin will take over: down a step, a rest, a held sixth, home
    raw3: cello('[d3@3 c3] b2 [e3@2 g3@2] [f3@3 a2] [d3@2 f3@2] [g3@3 f3] e3 [c3@2 a2@2]'),
    raw4: piano(PIANO + ' ' + PIANO),
  }),

  section('lift', 8, { role: 'develop', progression: WARM,
    raw:  sub(SUB),
    raw2: bass(BASS2),
    raw3: cello('[d3@2 e3@2] [b2@3 d3] [e3@4] [f3@2 c3@2] [a2@3 d3] [g3@2 b2@2] [e3@3 g3] [a2@4]'),
    raw4: piano(PIANO2 + ' ' + PIANO2),
    // the violin takes the tune: root, step up, a held fourth, a leap to the octave, and back down to the root
    raw5: violin('[d4@2 e4 f4] [g4@3 ~] [e4@2 g4 a4] f4 [a4@2 ~ d5] [d5@3 c5] [a4@2 g4 f4] [e4@2 d4@2]',
                 { velocity: '.8 .95 .85 1 .9 1 .85 .9' }),
    // the flute only answers, in the bars the violin leaves open
    raw6: flute('~ [~@2 d5@2] ~ [~@2 c5 a4] ~ [~@3 a4] ~ [f5@2 e5@2]'),
  }),

  section('hold', 8, { role: 'climax', progression: WARM,
    raw:  sub(SUB),
    raw2: bass(BASS2),
    raw3: cello('[d3@2 f3@2] [g3@3 d3] [e3@2 c3@2] [f3@4] [a3@2 f3@2] [g3@3 b2] [c3@2 e3@2] [d3@4]'),
    raw4: piano(PIANO3 + ' ' + PIANO3),
    // the tune an octave up, wider intervals, the top note held over the chord change
    raw5: violin('[d5@2 f5@2] [g5@3 d5] [e5@2 g5@2] [f5@4] [a5@3 g5] [d5@2 f5@2] [e5@2 c5@2] [d5@4]',
                 { level: .95, velocity: '.9 1 .95 1 1 1 .95 .9' }),
    // the flute doubles a third under and then goes above
    raw6: flute('[a4@4] [b4@3 ~] [c5@2 e5@2] [a4@4] [~@2 c6@2] [b5@3 a5] [g5@2 ~@2] [a5@2 d6@2]', { level: .8 }),
    raw7: strings(PADS + ' ' + PADS),
  }),

  section('rest', 4, { role: 'release', progression: 'i III VII i',
    raw:  sub('d1 f1 c1 d1'),
    raw2: bass('d2 f2 c2 d2'),
    // the cello has the last word: the opening phrase, slower, ending on the root
    raw3: cello('[d3@3 c3] [a2@4] [e3@2 g3@2] [d3@4]'),
    raw4: piano('[d2 [a2,d3,f3]@3] [f2 [c3,f3,a3]@3] [c2 [g2,c3,e3]@3] [d2 [a2,d3,f3,d4]@3]'),
  }),
])
