// glassworks-mixed: glassworks after the mixing pass, kept next to the original so the two can be A/B'd. Same notes,
// same patches, same movements; what changed is where each part sits and how much of it there is. The drums were the
// mix (-0.5 dB under it, clipping alone), the glass lead was 19 dB down and its octave twin 33 dB down (inaudible), and
// every part sat dead centre in its own room. Now: one room on the song (a 1.2 s medium room, darker tail) with each
// part's space as its send; drums brought down to leave headroom; the lead brought up to foreground (6..12 dB under the
// mix) and set a little right, its twin a little left and farther back; the reese bass and kick centre, ducked with a
// written recovery; the pad wide and behind. `npm run measure -- songs/glassworks-mixed.strudel bloom` shows the table;
// compare with the same on songs/glassworks.strudel.
// arrive -> turn -> lift -> bloom -> settle. A minor, cps .5. Axis values are 0..1 with 0.5 = the layer's baseline.

const lead = { sound: 'triangle', patch: 'glass', follow: 'tones', phrase: 2, notes: '0 ~ 1 2 ~ 3 2 1 ~ 0 1 ~ 2 3@2 ~', register: .6, articulation: .55, space: .55, position: .15 };
const wide = { sound: 'sawtooth', patch: 'wide', articulation: .15, space: .7, width: .7, brightness: .4 };
const deep = { sound: 'square', patch: 'reese', register: .25, weight: .7, articulation: .55, brightness: .4, space: .4 };

song({ cps: .5, key: 'A:minor', seed: 21, kit: 'RolandTR909', room: { size: 1.2, decay: .3, damping: 7000 } }, [

  // a pad breathing on its own: brightness wobbles once every four bars, the room swells up and back over the section
  section('arrive', 8, { role: 'establish', progression: 'i@2 VI/1 VII',
    pad:   { ...wide, density: .4, brightness: wobble(.25, .55, 4), space: swell(.5, .95), level: .5 },
    drums: { template: 'minimal', density: .25, space: .6, brightness: .3, level: .35 },
  }),

  // the lead on chord tones, drifting a little around its place; the bass pulses its filter four times a bar
  section('turn', 8, { role: 'develop', progression: 'i VI/1 III VII',
    drums:  { template: 'minimal', density: .45, groove: .6, brightness: .4, level: .4 },
    bass:   { ...deep, density: .75, notes: '0 0 4 3', brightness: pulse(.3, .6), duck: 'drums', duckDepth: .3, duckAttack: .15, level: .75 },
    melody: { ...lead, density: .5, width: drift(.5, .7), brightness: .55, level: 1.1 },
    pad:    { ...wide, density: .5, brightness: wobble(.3, .6, 4), level: .4, duck: 'drums', duckDepth: .15, duckAttack: .25 }, // "wobbling brightness"
  }),

  // everything rises: the lead's filter by a ramp, the pad's room by a swell, into a dominant seventh held for two bars
  section('lift', 8, { role: 'develop', progression: 'iv VI/1 V7/2@2', sweep: 1,
    drums:  { template: 'breaks', density: .6, drive: .6, brightness: .5, level: .4 },
    bass:   { ...deep, density: .75, notes: '0 4 0 3', brightness: pulse(.35, .65), weight: .75, duck: 'drums', duckDepth: .35, duckAttack: .15, level: .75 },
    melody: { ...lead, density: .6, brightness: ramp(.45, .85), width: drift(.5, .8), level: 1.2 },
    pad:    { ...wide, density: .6, space: swell(.6, 1), brightness: ramp(.35, .6), level: .4, duck: 'drums', duckDepth: .2, duckAttack: .25 },
    fx:     { riser: 3, level: .7 },
  }),

  // the bloom: a wider pad, the lead doubled an octave up by a second glass voice off to the other side, the bass locked to the kick
  section('bloom', 16, { role: 'climax', progression: 'i VI/1 III VII',
    drums:   { template: 'breaks', density: .85, drive: .8, articulation: .6, brightness: .5, weight: .55, variation: .4, level: .4, compressor: { threshold: -24, ratio: 4, attack: .002, release: .08 } }, // the kit's crest (16 dB) is what clips the downbeat, not its level; brightness a notch down since the compressor lifts the hats against the kick
    bass:    { ...deep, density: .75, notes: '0 7 0 4', brightness: pulse(.4, .7), weight: .85, aggression: .5, duck: 'drums', duckDepth: .5, duckAttack: .15, level: .75 },
    melody:  { ...lead, density: .7, brightness: .8, width: drift(.5, .9), level: 1.3 },
    melody2: { ...lead, notes: '~ ~ 4 ~ ~ ~ 5 ~ ~ ~ 4 ~ ~ ~ ~ ~', register: .85, level: 1.6, space: .75, brightness: .4, position: -.4 },
    pad:     { ...wide, density: .75, brightness: wobble(.4, .75, 2), width: .9, duck: 'drums', duckDepth: .7, duckAttack: .25, level: .4 },
    fx:      { impact: true, level: .4 },
  }),

  // the tonic held four bars, the pad's wobble slowing to once every eight, the lead's last phrase unanswered
  section('settle', 8, { role: 'release', progression: 'i@4', dropout: 1,
    bass:   { ...deep, density: .4, notes: '0 ~', brightness: .3, weight: .6, level: .6 },
    melody: { ...lead, notes: '0 ~ 1 2 ~ 3 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~', density: .4, brightness: ramp(.6, .3), level: 1 },
    pad:    { ...wide, density: .5, brightness: wobble(.25, .5, 8), space: swell(.7, 1), level: .5 },
  }),
])
