    raw:    bass(PUSH),
    raw2:   pick([Em, A, C, D].join(' ')),
    // the nylon answers the climb by falling: sweeps down the shapes, a pedal lick on the fifth, and it hands back under the root
    melody2: { ...nylon, phrase: 8, brightness: .75, velocity: '.9 1 .9 1 .95 1 .95 1',
              notes: '[[12 11 9 7] [9 7 5 4] [12 11 9 7] [9 7 5 4]] [[5 4 2 0] [5 4 2 0] 4@2 [7 5 4 2]] [[4 7 11 7] [4 7 11 7] [5 9 12 9] [5 9 12 9]] [[12 11 9 7] [5 4 2 0] 4@2 [4 5 7 9]] [[4 5 4 5] [7 9 7 9] [11 12 11 12] [14 12 11 9]] [7@2 [9 7] 5 [4 5 4 2] 0@2] [[4 0 4 7] [4 0 4 9] [5 2 5 11] [5 2 5 12]] [[11 9 7 5] [4 2 0 -1] 0@2 ~ ~]' },
