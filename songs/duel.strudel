    raw:    bass(PUSH),
    raw2:   pick([Em, A, C, D].join(' ')),
    // the nylon answers lower and off the beat, then climbs through the chord shapes and a rising pedal lick
    melody2: { ...nylon, phrase: 8, brightness: .75, velocity: '.9 1 .9 1 .95 1 .95 1',
              notes: '[[0 ~ 0 2] [4 ~ 4 5] [7 ~ 7 9] [11 9 7 5]] [4@2 [5 4] 2 [0 2 0 -1] 0@2] [[0 2 4 7] [9 7 4 2] [0 2 4 7] [9 11 12 14]] [12@3 [11 9] 7 [5 4 2 0] ~ ~] [[7 7 9 7] [5 5 7 5] [4 4 5 4] [2 2 4 2]] [[0 4 7 11] 12@2 ~ [11 9 7 5] 4@2] [[9 7 9 11] [9 7 9 12] [9 7 9 14] [12 11 9 7]] [7@2 [5 4] 2 0@3 ~]' },
  }),
  section('break', 4, { role: 'breakdown', progression: 'i IV i VII',
    raw:    bass('[e2 ~ ~ ~] [a1 ~ ~ ~] [e2 ~ ~ ~] [d2 ~ ~ b2]'),
    raw2:   pick([Em, A, Em, D].join(' ')),
    // the hook at half speed, both guitars in thirds, a breath before the third pair
    melody: { ...lead, phrase: 4, follow: true, level: 1.3, velocity: '.8 .9 .85 .9', notes: '0@2 ~ 2 3@2 ~ 4 3@2 2 0@2 ~ ~ 4' },
    melody2: { ...nylon, phrase: 4, follow: true, level: 1.1, velocity: '.8 .9 .85 .9', notes: '2@2 ~ 4 5@2 ~ 6 5@2 4 2@2 ~ ~ 6' },
  }),
  section('solo3', 8, { role: 'develop', progression: LIFT,
    drums:  { ...quiet, template: HALF, density: .55, level: .28, variation: .15 },
    raw:    bass(WALK),
    raw2:   pick([Em, A, C, D].join(' ')),
    // the third breathes: rests, held notes and double-stops over a halftime kit, then a pair of runs to hand off
    melody: { ...lead, phrase: 8, brightness: .75, velocity: '.85 1 .8 1 .85 1 .9 .95',
