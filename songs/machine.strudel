// @blog
// machine: filthy mechanical industrial rock at 120 BPM, straight 4/4, one dark minor centre (E minor, i only).
// The groove is a physical loop; everything around it corrodes. Tension comes from density, drive, distortion,
// filtering and texture, never from harmony. Each rebuild is more damaged than the last; the ending is not a resolution.
// Mixed as a scene: before the mixing pass chorus3 had the kit as the mix (1.7 dB
// under it, 8% of samples clipping), the sub pad 5 dB down and peaking at full scale on its own, the bass 6 dB down,
// the melody 19 dB down, and everything dead centre in its own room. Now: one small dead room on the song with each
// part's space as its send (the machine stays dry); the kit brought down to leave headroom; the bass under the kick,
// ducked with a written recovery; the pad down to a foundation that pumps under the kick; the melody up to
// foreground, a little right. The textures outside the song keep their own gains and pans.
// `npm run measure -- songs/machine.strudel chorus3` shows the table.
// Third pass, headroom: every part and most textures distort, and superdough's distortion outputs tanh clamped to full
// scale whatever the gain before it, so `level` never moved their peaks and the sum ran 2.7% of chorus3 into the output
// wall (0.7% pinned at it). `postgain` is the gain after the distortion: kit .4, bass .5, pad .6, melody .8, the drone
// .5 and the other distorted textures .6/.7. The whole song now peaks at .91 with no sample past .8, six dB quieter
// than the wall was faking: turn it up.
// Fourth pass, what was still ugly once nothing clipped (the lint named all of it): the bass at weight .95..1 sat an
// octave under its register, midi 16 (21 Hz), a rumble whose distortion harmonics were all anyone heard, now weight .7
// at octave 2 (E2) with a written line under the hook ('0 0 7 0' in the choruses, '0 ~ 0 0' elsewhere); bass, melody
// and pad were three raw saws in one section (mud), now the melody is a square and the pad a triangle, the bass keeps
// the saw; the kit's distortion on 16th hats (aggression .9 = distort .48, weight 1 = shape .2) is now aggression
// .65..75 and weight .85, the bass and pad aggression .75/.8, the melody .8; the stabs and grind carried `.coarse()`,
// a worklet this page's bundle never defines, so they had been silent (an error in #err per hit) and now sound at
// distort .6/.5; the drone, scream and squeals distort less. The melody had become the mix (2.4 dB under it): postgain
// .5. Chorus3's parts measure kit 4.7 dB under the mix, melody 4.6, pad 7.6, bass 8.1; the loud end with its textures
// peaks at .72. The kick and bass still share the low band (lint .68): E2 is as high as an industrial bass goes and the
// duck at depth .5 is the fix that is written.
// intro → arrive → verse → build → chorus → breakdown → rebuild → verse2 → chorus2 → chorus3 → burnout. 68 cycles.
// Axis values are 0..1 with 0.5 = the layer's baseline. Mechanical: organicness 0, groove 0, variation low until it isn't.
const M = { organicness: 0, groove: 0 };
const kit = { ...M, level: .3, postgain: .4 };
const low = { ...M, level: .7, postgain: .5, duck: 'drums', duckDepth: .5, duckAttack: .1 };
const top = { ...M, level: 1.6, postgain: .5, sound: 'square', position: .1, weight: .58 }; // closer
const sub = { level: .4, postgain: .6, sound: 'triangle', duck: 'drums', duckDepth: .4, duckAttack: .15 };
// second pass: the generated small room (samples/user/rooms) cut to half a second: early reflections and a door, no tail. No humanize: the
// machine is mechanical by design. Depth on the melody by the closer word.
const machine = song({ cps: .5, key: 'E:minor', seed: 23, kit: 'RolandTR909', packs: ['rooms'], room: { ir: 'room', size: .5, damping: 3500 } }, [
  section('intro', 4, { role: 'establish', progression: 'i',
    drums: { ...kit, template: 'minimal', density: .2, drive: .9, articulation: .9, brightness: .2, space: .1, variation: 0 },
  }),
  section('arrive', 4, { role: 'establish', progression: 'i',
    drums: { ...kit, density: .55, drive: .95, articulation: .85, brightness: .3, space: .15, weight: .8, variation: .05 },
    bass:  { ...low, weight: .7, notes: '0 ~ 0 0', density: .6, drive: .9, articulation: .55, register: .4, brightness: .15, space: .05, aggression: .6, variation: 0 },
  }),
  section('verse', 8, { role: 'develop', progression: 'i',
    drums:  { ...kit, density: .55, drive: .95, articulation: .85, brightness: .3, space: .15, weight: .8, variation: .1 },
    bass:   { ...low, weight: .7, notes: '0 ~ 0 0', density: .6, drive: .9, articulation: .8, register: .4, brightness: .25, space: .05, aggression: .6, variation: 0 },
  }),
  section('build', 4, { role: 'develop', progression: 'i',
    drums:  { ...kit, density: .7, drive: .95, articulation: .85, brightness: .4, space: .2, weight: .85, variation: .2 },
    bass:   { ...low, weight: .7, notes: '0 0 ~ 0', density: .6, drive: .9, articulation: .8, register: .4, brightness: .35, space: .05, aggression: .75, variation: 0 },
    melody: { ...top, notes: '0 ~ 0 3@2 ~ 2 0', density: .3, articulation: .85, register: .2, brightness: .4, space: .2, width: .3, aggression: .7, variation: .1 },
    pad:    { ...sub, density: .15, articulation: .1, brightness: saw.range(.05, .3).slow(4), weight: .7, space: .3, width: .5, aggression: .8, register: .1 },
  }),
  section('chorus', 8, { role: 'climax', progression: 'i',
    drums:  { ...kit, density: .85, drive: .95, articulation: .75, brightness: .5, space: .4, weight: .85, aggression: .65, width: .7, variation: .25 },
    bass:   { ...low, weight: .7, notes: '0 0 7 0', density: .6, drive: .9, articulation: .8, register: .4, brightness: .4, space: .05, aggression: .75, variation: 0 },
    melody: { ...top, notes: '0 ~ 0 3@2 ~ 2 0', density: .4, articulation: .8, register: .2, brightness: .45, space: .3, width: .6, aggression: .8, variation: .15 },
    // the pad sits under width .8 in every climax: .8+ is jux, a doubled copy of every voice, and here every voice also carries
    // a distortion worklet; with it chorus3 ran ~46 voices at once (worklets counted), past what the audio thread renders in real
    // time (scratches, dropped hits); at .75 it sweeps instead, ~32
    pad:    { ...sub, density: .5, articulation: .2, brightness: .35, weight: .7, space: .5, width: .75, aggression: .8, register: .1 },
  }),
  section('breakdown', 4, { role: 'develop', progression: 'i',
    drums: { ...kit, template: 'minimal', density: .2, drive: .9, articulation: .9, brightness: .2, space: .5, weight: .8, variation: 0 },
    bass:  { ...low, weight: .7, notes: '0 ~ 0 0', density: .25, drive: .9, articulation: .9, register: .4, brightness: .2, space: .3, aggression: .6, variation: 0 },
  }),
  section('rebuild', 4, { role: 'develop', progression: 'i',
    drums:  { ...kit, density: .6, drive: .95, articulation: .85, brightness: .35, space: .2, weight: .85, aggression: .6, variation: .3 },
    bass:   { ...low, weight: .7, notes: '0 ~ 0 0', density: .6, drive: .9, articulation: .8, register: .4, brightness: .3, space: .05, aggression: .75, variation: .1 },
    pad:    { ...sub, density: .15, articulation: .1, brightness: .15, weight: .7, space: .3, width: .5, aggression: .8, register: .1 },
  }),
  section('verse2', 8, { role: 'develop', progression: 'i',
    drums:  { ...kit, density: .6, drive: .95, articulation: .85, brightness: .35, space: .15, weight: .85, aggression: .65, variation: .35 },
    bass:   { ...low, weight: .7, notes: '0 ~ 0 0', density: .6, drive: .9, articulation: .8, register: .4, brightness: .3, space: .05, aggression: .75, variation: .1 },
    pad:    { ...sub, density: .15, articulation: .1, brightness: .1, weight: .7, space: .3, width: .5, aggression: .8, register: .1 },
  }),
  section('chorus2', 8, { role: 'climax', progression: 'i',
    drums:  { ...kit, density: .9, drive: .95, articulation: .7, brightness: .55, space: .45, weight: .85, aggression: .65, width: .8, variation: .45 },
    bass:   { ...low, weight: .7, notes: '0 0 7 0', density: .65, drive: .9, articulation: .8, register: .4, brightness: .45, space: .05, aggression: .75, variation: .1 },
    melody: { ...top, notes: '0 ~ 0 3@2 ~ 2 0', density: .5, articulation: .8, register: .2, brightness: .5, space: .3, width: .7, aggression: .8, variation: .3 },
    pad:    { ...sub, density: .75, articulation: .2, brightness: .4, weight: .7, space: .55, width: .75, aggression: .8, register: .1 },
  }),
  section('chorus3', 8, { role: 'climax', progression: 'i',
    drums:  { ...kit, density: .95, drive: .95, articulation: .7, brightness: .6, space: .5, weight: .85, aggression: .75, width: .85, variation: .5 },
    bass:   { ...low, weight: .7, notes: '0 0 7 0', density: .65, drive: .9, articulation: .8, register: .4, brightness: .5, space: .05, aggression: .75, variation: .1 },
    melody: { ...top, notes: '0 ~ 0 3@2 ~ 2 0', density: .55, articulation: .8, register: .2, brightness: .55, space: .3, width: .75, aggression: .8, variation: .3 },
    pad:    { ...sub, density: .9, articulation: .2, brightness: .45, weight: .7, space: .6, width: .75, aggression: .8, register: .1 },
  }),
  section('burnout', 8, { role: 'release', progression: 'i',
    drums: { ...kit, template: 'minimal', density: .15, drive: .9, articulation: .9, brightness: saw.range(.3, 0).slow(8), space: .8, weight: .9, aggression: .9, variation: .3 },
    pad:   { ...sub, density: .15, articulation: 0, brightness: saw.range(.2, 0).slow(8), weight: .7, space: .9, width: .5, aggression: .8, register: .1 },
  }),
]);

// Textures the axis layers don't model: brittle metal pulse, hiss, static bursts, reversed scrapes,
// short synth squeals answering the melody, a distorted low drone, feedback screams and a decaying loop.
const pulse   = s("metal:2").struct("x ~ x x ~ x ~ x").lpf(1800).hpf(400).clip(.3).gain(.45).pan(.4);
const ticks   = s("metal:1").struct("x*16").degradeBy(.55).hpf(5000).clip(.08).gain(.3).pan(.65);
const hiss    = s("pink").hpf(3500).clip(1).gain(.12);
const bursts  = s("white").struct("~ ~ ~ x ~ ~ ~ ~ ~ ~ x ~ ~ ~ ~ ~").clip(.12).hpf(2000).distort(.6).gain(.35).postgain(.7).degradeBy(.4);
const scrapes = s("metal").n("<5 7 3 9>").speed("<-1 -.7 -1.3>").struct("~ ~ x ~ ~ ~ ~ ~").lpf(2500).room(.3).gain(.4);
const squeals = note("<e5 ~ g5 ~ ~ b5 ~ ~>").s("sawtooth").distort(.5).lpf(sine.range(800, 4000).fast(2)).clip(.2).release(.05).gain(.22).postgain(.7).pan(sine.slow(3));
const stabs   = note("<e2 e2 g2 e2>").s("sawtooth").struct("x ~ ~ x ~ ~ x ~ ~ ~ x ~ ~ ~ ~ x").hpf(700).lpf(2200).distort(.6).clip(.15).release(.02).gain(.3).postgain(.6).pan("<.25 .75>");
const grind   = note("[e3 e3 e4 e3 g3 e3 b3 e3]*2").s("sawtooth").hpf(500).distort(.5).clip(.5).release(.03).gain(.35).postgain(.6).pan(.55);
const breaths = s("brown").struct("~ ~ ~ ~ ~ ~ x ~").attack(.15).release(.4).lpf(sine.range(300, 1500).slow(2)).distort(.4).gain(.25).postgain(.7);
const drone   = note("e1").s("sawtooth").distort(.5).lpf(perlin.range(120, 500)).clip(1).gain(.45).postgain(.5);
const scream  = note("<b5 e6>").s("sine").vib(9).vibmod(.6).distort(.6).lpf(sine.slow(3).range(1000, 6000)).clip(1).gain(.18).postgain(.6).pan(sine.fast(.7));
const decay   = pulse.lpf(saw.range(1800, 300).slow(8)).degradeBy(saw.range(0, .8).slow(8)).gain(saw.range(.45, .15).slow(8));

const textures = arrange(
  [4, stack(pulse, hiss)],
  [4, stack(pulse, hiss)],
  [8, stack(hiss, ticks, bursts, scrapes, squeals, breaths, stabs.gain(.4), scream.gain(.1), grind.degradeBy(saw.range(.7, .1).slow(8)).lpf(saw.range(900, 4000).slow(8)))],
  [4, stack(hiss, ticks, bursts, scrapes, drone.gain(.3))],
  [8, stack(hiss, ticks.degradeBy(.2), bursts, scrapes, squeals, drone)],
  [4, stack(hiss.gain(.2), ticks, breaths)],
  [4, stack(hiss, ticks, bursts, scrapes, drone.gain(.35))],
  [8, stack(hiss, ticks, bursts.degradeBy(.1), scrapes.fast(2), squeals, breaths, stabs.gain(.45), scream.gain(.15), grind.gain(.4).degradeBy(saw.range(.4, 0).slow(8)).lpf(saw.range(1500, 5000).slow(8)), drone.gain(.3))],
  [8, stack(hiss, ticks, bursts, scrapes, squeals, drone, scream.gain(.1))],
  [8, stack(hiss, ticks, bursts, scrapes, squeals, drone, scream)],
  [8, stack(hiss.gain(saw.range(.12, .3).slow(8)), decay, drone.gain(saw.range(.45, .2).slow(8)), scream.gain(saw.range(.18, 0).slow(8)))],
);

// stack() drops the song metadata the checker, resolver and page use for section tables; put it back.
const out = stack(machine, textures);
out.strudel = machine.strudel;
out
