// @hidden
// hunted: someone is running from something, and a voice on the radio tells them where to go.
// Mixed as a scene: before the mixing pass `run` had the kit as the mix (0.8 dB under it,
// clipping), the radio 16 and 29 dB down, the runner's harp 31 dB down, the bowed vibraphone 53, the didgeridoo 50, the
// gong 43 and the bowed strings 38 (all inaudible), and the radio, the riser and the kit all dead centre, each part in
// its own room. Now: one dark room on the song with each part's space as its send; the kit brought down to leave
// headroom; the bass under the kick, ducked with a written recovery; the radio up to foreground and set to one side
// (one radio, so every voice part sits there); the harp up and a little right, the glass counter-figure a struck
// vibraphone (the bowed sample is too quiet to place) set left; the thing a loud organ pedal just off centre (neither
// didgeridoo take carried: the bark is over before it is heard, the sustained one measured 34 dB under the mix at
// level 2); the gong right; the strings up and right, the drone centre and behind, the heartbeat felt.
// `npm run measure -- songs/hunted.strudel run` shows the table.
//
// The `voice` pack this needs is not in the repo: the takes are licensed from GameDevMarket, whose Licence (A) 4.2(b)
// forbids redistributing the asset other than as part of a media product, so they are gitignored and the pack never
// deploys. On any other machine this song reports `missing pack "voice"` and is skipped by the checker and the build.
//
// Two things play at once and they do not agree. The runner follows the harmony -- harp and bowed vibraphone,
// moving, phrasing over two bars, always reaching back for the tonic. The thing hunting does not follow it at all
// (`follow: false`): it holds degree 0 and degree 1, E and F, the tonic and the phrygian b2, against whatever chord
// is underneath. That semitone is what the mode is for, and it is the whole score in one interval. In `found` the
// thing stops alternating and simply holds the F.
//
// The voice comes from samples/user/voice, a shared pack: one folder per phrase, two or three takes inside each, so
// `forward` is a sound with variants and `forward:1` is the second take. The pack's pack.json trims every take to the
// shouted words (begin/end are fractions of the file) and calls that region half a bar -- each shout is about a
// second, and a bar here is two -- so `bars: 0.5` is what makes it play at its recorded speed.
//
// bars is also the pattern's span, so one step of a voice pattern below is half a bar, not a whole one, and `~!6` is
// six rests: `<0 ~!6>` is a shout every seven half-bars. A part can only hold one sound, so a line of different
// directions is several parts laid over each other. In chase left and forward run on co-prime periods (7 and 5
// half-bars) so the order never repeats, and they converge on bar 14.
//
// The takes are not interchangeable: there is 18 dB between the softest and the loudest in this pack. 'go right'
// take 2 is the hardest direction in it (+7.9 dB over 'go left' take 1), so it is not a routine call -- it is kept
// for bar 14, shouted over the other two, and 'get out of there' (+12.3 dB, the loudest thing here) only ever lands
// where the section breaks. The take picks how the line is delivered; `level` places it in the mix.
//
// `back-chop` and `out-chop` are the same takes with break points between the words -- slices as a list of fractions
// of the file, not a count -- so 'go / back' and 'get / out of there' can be re-ordered and stuttered once the runner
// stops being given time to listen. They are left unstretched: a slice keeps its own length, so the words stay words.

// --- the runner: follows the harmony, phrases over two bars, keeps reaching for the tonic
const theme   = { sound: 'harp', follow: true, phrase: 2, notes: '0 ~ 1 0 ~ ~ ~ ~ 4 ~ 3 ~ 1 ~ 0@2', register: .6, articulation: .5, space: .5, width: .5, brightness: .45, position: .15, velocity: '.85 1 .9 1 .8 1 .9 .95', weight: .58, humanize: { timingMs: 12, velocity: .1, correlation: 'phrase' } }; // closer, and played
const answer  = { ...theme, notes: '0 ~ 1 0 ~ 1 ~ ~ 4 ~ 5 4 ~ 1 0@2' };
const broken  = { ...theme, notes: '0 ~ 1 0 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~' };
// a counter-figure, not a second theme: it enters where the theme rests and leans on 5, the b6
const glass   = { sound: 'vibraphone', follow: true, phrase: 2, notes: '~ ~ ~ ~ 4 ~ 5 ~ ~ ~ ~ ~ 6 ~ 5@2', register: .5, articulation: .35, space: .7, width: .6, brightness: .35, level: .6, position: -.4 };
const chimes  = { sound: 'handchimes', follow: false, notes: '~ ~ 1 ~ ~ ~ ~ ~', register: .85, articulation: .35, space: .9, width: .8, level: .8, position: -.3 };

// --- the thing: follow false, so the chords move under it and it does not. 0 and 1 are E and F.
const stalker = { sound: 'pipeorgan_loud_pedal', follow: false, phrase: 2, notes: '0@6 ~ ~ 1@6 ~ ~', register: .2, brightness: .2, articulation: .1, space: .4, width: .3, position: -.1 }; // the didgeridoo takes never carried: the bark (:0) is over before it is heard and the sustained one (:8) measured 34 dB under the mix at level 2; the loud pedal holds the semitone against the quiet organ drone
const grind   = { ...stalker, notes: '1@6 ~ ~ 0@6 ~ ~' };
const held    = { ...stalker, notes: '1@8 1@8' }; // it stops alternating: the b2, and it stays there
const toll    = { sound: 'gong', follow: false, phrase: 2, notes: '0 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~', register: .3, articulation: .1, space: .95, width: .8, brightness: .25, level: 2, position: .35, compressor: { threshold: -18, ratio: 3 } };

// --- the room
const drone   = { sound: 'pipeorgan_quiet', articulation: .05, space: .8, width: .5, weight: .8, register: .2, brightness: .15 };
const strings = { sound: 'psaltery_bow', articulation: .1, space: .93, width: .7, weight: .52, brightness: .18, position: .25 }; // farther
const breath  = { sound: 'wineglass_slow', articulation: .15, space: .9, width: .8, register: .75, brightness: .45, position: -.2 };
const low     = { space: .35, duck: 'drums', duckDepth: .3, duckAttack: .12 };

// --- a heartbeat that only exists once they stop moving (see hunted.strudel)
const heart   = { template: 'heartbeat', sounds: { bd: 'YamahaRY30_bd' }, space: .7, brightness: .2, articulation: .3, variation: 0 };

// --- the radio: one set, one place on the stage
const radio   = { position: .3, weight: .58, compressor: { threshold: -18, ratio: 3 } }; // closer; the shouts are sparse and spiky (crest 11..19), so a compressor per hit is cheap

// second pass: a generated hall (samples/user/rooms, 3.2 s, 30 ms pre-delay) instead of the synthetic tail; the harp humanized; the radio
// and the gong compressed (sparse, spiky); depth by the closer/farther words on the radio and the strings, not level alone.
song({ cps: .5, key: 'E:phrygian', seed: 13, kit: 'RolandTR909', packs: ['voice', 'rooms'], room: { ir: 'hall', size: 3.2, damping: 4500 } }, [

  // out in the open, moving but not yet chased: four turns called, never the same twice, and something already
  // underneath that is not moving with the chords
  section('alley', 8, { role: 'establish', progression: 'i i II i',
    drums:   { density: .3, space: .6, brightness: .3, articulation: .35, level: .3 },
    bass:    { ...low, weight: .5, density: .3, brightness: .3, notes: '0 ~ ~ ~ 0 ~ ~ ~', level: .7 },
    melody:  { ...theme, density: .3, level: 1.4, brightness: .35 },
    melody2: { ...stalker, density: .3, level: .5 },
    pad:     { ...drone, density: .3, brightness: .12, level: .7 },
    pad2:    { ...strings, density: .3, brightness: .2, register: .3, level: .8 },
    sample:  { ...radio, sound: 'forward',   pattern: '<0 ~!15>',     space: .65, brightness: .45, level: .325 },
    sample2: { ...radio, sound: 'left',      pattern: '<~!5 0 ~!10>', space: .65, brightness: .45, level: .325 },
    sample3: { ...radio, sound: 'right',     pattern: '<~!11 0 ~!4>', space: .65, brightness: .45, level: .325 }, // take 1: the quiet 'right', nothing is urgent yet
    sample4: { ...radio, sound: 'forward:1', pattern: '<~!14 0 ~>',   space: .65, brightness: .45, level: .325 },
  }),

  // it has our scent. left and forward on co-prime periods, so the turns come in an order that never settles; at bar
  // 14 they land together and 'go right' -- the hardest take in the pack -- arrives over the top, its only appearance.
  // the riser takes the last four bars, then 'get out of there' on the way out
  section('chase', 16, { role: 'develop', progression: 'i II i v',
    drums:   { density: .7, drive: .65, articulation: .55, brightness: .55, variation: .5, weight: .42, level: .4 },
    bass:    { ...low, weight: .6, density: .65, brightness: .45, notes: '0 ~ 0 0 ~ 3 ~ 0', level: .85 },
    melody:  { ...theme, density: .5, brightness: saw.range(.3, .55).slow(8), level: 1.8 },
    melody2: { ...glass, density: .4, brightness: .3 },
    melody3: { ...grind, density: .5, level: .6 },
    pad:     { ...drone, density: .5, brightness: .18, level: .7 },
    pad2:    { ...strings, density: .5, brightness: .25, register: .35, level: .9 },
    fx:      { riser: 4, level: .5 },
    sample:  { ...radio, sound: 'left',      pattern: '<0 ~!6>',      space: .55, brightness: .5, level: .325 },  // period 7
    sample2: { ...radio, sound: 'forward:1', pattern: '<~!3 0 ~>',    space: .55, brightness: .5, level: .25 },    // period 5
    sample3: { ...radio, sound: 'right:1',   pattern: '<~!28 0 ~!3>', space: .55, brightness: .5, level: .25 },    // bar 14 only
    sample4: { ...radio, sound: 'out',       pattern: '<~!31 0>',     space: .5, brightness: .55, level: .225 },
  }),

  // pressed into a doorway, not breathing. the kit stops and a timpani heartbeat takes over; the thing is close
  // enough now to be the loudest voice in the section, and it is still not following the chords
  section('hide', 8, { role: 'release', progression: 'i i i i',
    drums:   { density: .12, space: .8, brightness: .2, articulation: .2, level: .25 },
    drums2:  { ...heart, density: .25, level: .3 }, // felt, not dominant
    melody:  { ...chimes, density: .25 },
    melody2: { ...stalker, density: .5, level: .9 },
    pad:     { ...drone, density: .3, brightness: .1, level: .8 },
    pad2:    { ...strings, density: .3, brightness: .15, register: .25, level: 1 },
    pad3:    { ...breath, density: .25, level: .6 },
    sample:  { ...radio, sound: 'down',   pattern: '<0 ~!15>',    space: .8, brightness: .3,  weight: .35, level: .25 },
    sample2: { ...radio, sound: 'coming', pattern: '<~!6 0 ~!9>', space: .85, brightness: .25, weight: .4, level: .35 },
    sample3: { ...radio, sound: 'out',    pattern: '<~!14 0 ~>',  space: .65, brightness: .45, weight: .6, level: .3 },
  }),

  // found. the chops arrive at bars 0, 2, 4, 6, then 9, 11, 12, 13, 14, 15, 15.5: the gaps close until there is no
  // time left to listen. no riser here: the acceleration is the build.
  section('run', 16, { role: 'climax', progression: 'i II iv v',
    drums:   { density: .82, drive: .9, articulation: .45, brightness: .42, variation: .45, weight: .55, level: .3 },
    drums2:  { ...heart, density: .28, level: .15, space: .5 },
    bass:    { ...low, weight: .7, density: .8, brightness: .55, notes: '0 0 7 0 3 0 ~ 10', level: .8 },
    melody:  { ...answer, density: .7, brightness: .6, level: 2, register: .55 },
    melody2: { ...glass, density: .6, brightness: .4 },
    melody3: { ...grind, density: .7, level: .6 },
    melody4: { ...toll, density: .5 },
    pad:     { sound: 'harp', arp: 'down', space: .5, brightness: .6, width: .7, level: 1.4, position: -.2 },
    pad2:    { ...drone, density: .7, brightness: .25, weight: .75, level: .7 },
    pad3:    { ...strings, density: .6, brightness: .23, register: .4, level: 2 },
    fx:      { impact: true, level: .5 },
    sample:  { ...radio, sound: 'out-chop',  pattern: '<[0 0 ~ 1] ~!7 [0 0 ~ 1] ~!9 [0 0 ~ 1] ~!5 [0 0 ~ 1] ~!3 [0 0 ~ 1] ~ [0 0 ~ 1] ~>', space: .27, brightness: .65, level: .25 },
    sample2: { ...radio, sound: 'back-chop', pattern: '<~!4 [0 1 2 ~] ~!7 [0 1 2 ~] ~!9 [0 1 2 ~] ~!3 [0 1 2 ~] ~!4 [0 1 2 ~]>', space: .22, brightness: .6, level: .5 }, // back take 1 is -5.4 dB, the quietest chop source; the break points do not fit take 2
  }),

  // defeated: "he's here", one last useless instruction, and then the radio stops. the runner's theme gets four notes
  // in and gives up; the thing stops alternating and holds the b2 for the rest of the song
  section('found', 8, { role: 'release', progression: 'i i vii v',
    drums:   { density: .12, space: .8, brightness: .15, articulation: .15, level: .2 }, // .12: over bd's .1 threshold, under sd's .3, so a bare kick is left
    bass:    { ...low, weight: .85, density: .12, brightness: .15, notes: '0 ~ ~ ~ ~ ~ ~ ~', level: .9 },
    melody:  { ...broken, density: .25, level: 1.5, brightness: .3 },
    melody2: { ...held, density: .5, level: .8 },
    melody3: { ...toll, density: .3, level: 1.2 },
    pad:     { ...drone, density: .3, brightness: .1, level: .8 },
    pad2:    { ...strings, density: .3, brightness: .12, register: .25, level: 1 },
    pad3:    { ...breath, density: .2, level: .5 },
    sample:  { ...radio, sound: 'here:1', pattern: '<0 ~!15>',  space: .85, brightness: .35, weight: .6, level: .225 }, // take 2 delivers it; level puts it in a defeated mix
    sample2: { ...radio, sound: 'back', pattern: '<~!6 0 ~!9>', space: .9, brightness: .2, weight: .35, level: .4 }, // take 1 is the feeble one: right performance, audible level
  }),
])
