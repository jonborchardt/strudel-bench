// hunted: someone is running from something, and a voice on the radio tells them where to go.
//
// The voice comes from samples/user/voice, a shared pack: one folder per phrase, two or three takes inside each, so
// `forward` is a sound with variants and `forward:1` is the second take. The pack's pack.json trims every take to the
// shouted words (begin/end are fractions of the file) and calls that region half a bar -- each shout is about a
// second, and a bar here is two -- so `bars: 0.5` is what makes it play at its recorded speed. Naming the sound is
// then the whole part: `sample: { sound: 'forward' }`.
//
// bars is also the pattern's span, so one step of a voice pattern below is half a bar, not a whole one, and `~!6` is
// six rests: `<0 ~!6>` is a shout every seven half-bars. A part can only hold one sound, so a line of different
// directions is several parts laid over each other. In chase left and forward run on co-prime periods (7 and 5
// half-bars) so the order never repeats, and they converge on bar 14.
//
// The takes are not interchangeable: there is 18 dB between the softest and the loudest in this pack. 'go right'
// take 2 is the hardest direction in it (+7.9 dB over 'go left' take 1), so it is not a routine call -- it is kept
// for bar 14, shouted over the other two, and 'get out of there' (+12.3 dB, the loudest thing here) only ever lands
// where the section breaks. The take picks how the line is delivered; `level` places it in the mix.
//
// `back-chop` and `out-chop` are the same takes with break points between the words -- slices as a list of fractions
// of the file, not a count -- so 'go / back' and 'get / out of there' can be re-ordered and stuttered once the runner
// stops being given time to listen. They are left unstretched: a slice keeps its own length, so the words stay words.
song({ cps: .5, key: 'E:phrygian', seed: 13, kit: 'RolandTR909', packs: ['voice'] }, [

  // out in the open, moving but not yet chased: a pulse, a low room, and four turns called, never the same twice
  section('alley', 8, { role: 'establish', progression: 'i i II i',
    drums:  { density: .3, space: .7, brightness: .3, articulation: .35, level: .8 },
    pad:    { sound: 'psaltery_bow', space: .85, brightness: .2, width: .7, articulation: .15 },
    sample: { sound: 'forward',   pattern: '<0 ~!15>',     space: .7, brightness: .45 },
    sample2:{ sound: 'left',      pattern: '<~!5 0 ~!10>', space: .7, brightness: .45 },
    sample3:{ sound: 'right',     pattern: '<~!11 0 ~!4>', space: .7, brightness: .45 }, // take 1: the quiet 'right', nothing is urgent yet
    sample4:{ sound: 'forward:1', pattern: '<~!14 0 ~>',   space: .7, brightness: .45 },
  }),

  // it has our scent. left and forward on co-prime periods, so the turns come in an order that never settles; at bar
  // 14 they land together and 'go right' -- the hardest take in the pack -- arrives over the top, its only appearance.
  // the riser takes the last four bars, then 'get out of there' on the way out
  section('chase', 16, { role: 'develop', progression: 'i II i v',
    drums:  { density: .7, drive: .65, articulation: .55, brightness: .55, variation: .5 },
    bass:   { weight: .7, density: .65, brightness: .45, notes: '0 ~ 0 0 ~ 3 ~ 0' },
    melody: { sound: 'vibraphone_bowed', density: .4, brightness: .3, width: .55, register: .4, notes: '~ 2 ~ 1 ~ 2 ~ 0', phrase: 2 },
    pad:    { sound: 'psaltery_bow', space: .7, brightness: .3, width: .6 },
    fx:     { riser: 4 },
    sample: { sound: 'left',      pattern: '<0 ~!6>',       space: .6, brightness: .5 },                 // period 7
    sample2:{ sound: 'forward:1', pattern: '<~!3 0 ~>',     space: .6, brightness: .5, level: .75 },  // period 5
    sample3:{ sound: 'right:1',   pattern: '<~!28 0 ~!3>',  space: .6, brightness: .5, level: .8 },   // bar 14 only
    sample4:{ sound: 'out',       pattern: '<~!31 0>',      space: .55, brightness: .55, level: .7 },
  }),

  // pressed into a doorway, not breathing. three different warnings, one each: nothing is said twice
  section('hide', 8, { role: 'release', progression: 'i i i i',
    drums:  { density: .12, space: .9, brightness: .2, articulation: .2, level: .5 },
    pad:    { sound: 'psaltery_bow', space: .95, brightness: .15, width: .85, articulation: .1 },
    sample: { sound: 'down',   pattern: '<0 ~!15>',    space: .85, brightness: .3,  weight: .35, level: .6 },
    sample2:{ sound: 'coming', pattern: '<~!6 0 ~!9>', space: .9,  brightness: .25, weight: .4, level: .9 },
    sample3:{ sound: 'out',    pattern: '<~!14 0 ~>',  space: .7,  brightness: .45, weight: .6, level: .8 },
  }),

  // found. the chops arrive at bars 0, 2, 4, 6, then 9, 11, 12, 13, 14, 15, 15.5: the gaps close until there is no
  // time left to listen. no riser here: a reverbed noise sweep over the last four bars washed the kit out and made
  // the drop announce itself. the acceleration is the build. the kit drives rather than twitches: density under .85
  // drops the clap so four voices carry it, and articulation under .6 lets the hats ring instead of choking
  section('run', 16, { role: 'climax', progression: 'i II iv v',
    drums:  { density: .82, drive: .9, articulation: .45, brightness: .42, variation: .45, weight: .8 },
    bass:   { weight: .9, density: .8, brightness: .55, notes: '0 0 7 0 3 0 ~ 10' },
    melody: { sound: 'vibraphone_bowed', density: .6, brightness: .35, width: .6, register: .35, notes: '7 ~ 6 5 ~ 4 ~ 2' },
    pad:    { sound: 'harp', arp: 'down', space: .5, brightness: .6, width: .85, level: 1.4 }, // plucked: 2.8 dB under the bowed pad it replaced, so level puts it back
    fx:     { impact: true },
    sample: { sound: 'out-chop',  pattern: '<[0 0 ~ 1] ~!7 [0 0 ~ 1] ~!9 [0 0 ~ 1] ~!5 [0 0 ~ 1] ~!3 [0 0 ~ 1] ~ [0 0 ~ 1] ~>', space: .5, brightness: .65, level: .6 },
    sample2:{ sound: 'back-chop', pattern: '<~!4 [0 1 2 ~] ~!7 [0 1 2 ~] ~!9 [0 1 2 ~] ~!3 [0 1 2 ~] ~!4 [0 1 2 ~]>', space: .42, brightness: .6, level: 1.5 }, // back take 1 is -5.4 dB, the quietest chop source; the break points do not fit take 2
  }),

  // defeated: "he's here", one last useless instruction, and then the radio stops. the progression sinks instead of
  // resolving (i VII VI v, ending on the minor dominant) and a single low note holds under it
  section('found', 8, { role: 'release', progression: 'i i vii v',
    drums:  { density: .12, space: .9, brightness: .15, articulation: .15, level: .35 }, // .12: over bd's .1 threshold, under sd's .3, so a bare kick is left
    bass:   { weight: .85, density: .12, brightness: .15, notes: '0 ~ ~ ~ ~ ~ ~ ~', level: .7 },
    pad:    { sound: 'psaltery_bow', space: .95, brightness: .1, width: .9, articulation: .1, level: .8 },
    sample: { sound: 'here:1', pattern: '<0 ~!15>',  space: .9, brightness: .35, weight: .6, level: .5 }, // take 2 delivers it; level puts it in a defeated mix
    sample2:{ sound: 'back', pattern: '<~!6 0 ~!9>', space: .95, brightness: .2, weight: .35 }, // take 1 is the feeble one: right performance, audible level
  }),
])
