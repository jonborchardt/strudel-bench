// arc: a longer take on demo.strudel that travels from sad to happy.
// Mixed as a scene: before the mixing pass the drop had the drums as the mix (1.2 dB under it, 1.2% of samples
// clipping), the piano hook 18 dB down, the glockenspiel twin 56 dB down (inaudible), and drums, bass and pad all
// dead centre, each in its own room. Now: one room on the song with each part's space as its send; drums brought
// down to leave headroom; the bass under the kick, ducked with a written recovery; the piano up to foreground with a
// phrase-shaped velocity line, a little right; the bell twin a vibraphone (the glockenspiel sample is too quiet to
// place), lower in register, set left; the pad wide and behind, a little left, ducked lightly.
// `npm run measure -- songs/arc.strudel drop` shows the table.
// intro → verse (sad) → lift (turning) → drop → outro (happy). 40 cycles.
// Axis values are 0..1 with 0.5 = the layer's baseline.
const hook = { follow: true, phrase: 2, position: .1, velocity: '.85 1 .9 1 .8 1 .9 .95', space: .3, weight: .58, humanize: { timingMs: 12, velocity: .1, correlation: 'phrase' } }; // closer: space down, weight up; played, not diced
const bell = { sound: 'vibraphone', follow: true, register: .7, level: .8, space: .8, brightness: .38, weight: .42, position: -.4 }; // farther: darker, wetter, lighter
const low  = { space: .35, duck: 'drums', duckDepth: .35, duckAttack: .12 };
const bed  = { position: -.25, duck: 'drums', duckDepth: .15, duckAttack: .2 };

// second pass: the room is a generated plate (samples/user/rooms, 1.8 s, 15 ms pre-delay) instead of superdough's synthetic tail; the hook is
// humanized (a seeded, phrase-correlated feel); depth by the closer/farther words (brightness, space and weight together), not level alone.
song({ cps: .5, key: 'C:minor', seed: 3, kit: 'RolandTR909', packs: ['rooms'], room: { ir: 'plate', size: 1.8, damping: 6500 },
  visual: { composition: 'mosaic-climax', worlds: ['tunnel', 'ink', 'loom', 'orrery'] } }, [ // the stage: tunnel throughout, ink over it from the verse, loom and orrery as insets at the drop, the outro on ink's sheet
  section('intro', 8, { role: 'establish', sweep: 2,
    drums: { density: .3, space: .8, brightness: .1, drive: .1, articulation: .2, level: .5 },
    pad:   { ...bed, space: 1, articulation: 0, brightness: 0, drive: .1, register: .3, level: .6 },
  }),
  section('verse', 8, { role: 'develop', sweep: 2,
    drums:  { density: .6, groove: .6, brightness: .3, drive: .3, space: .55, articulation: .35, level: .5 },
    bass:   { ...low, weight: .7, register: .2, brightness: .3, drive: .3, articulation: .35, level: .75 },
    melody: { ...hook, density: .5, brightness: saw.range(.2, .5).slow(8), space: .55, register: .4, articulation: .35, sound: 'vibraphone', notes: '4 3 2@2 ~ 0 ~ 2 4 3 2@2 ~ 1 0@2', level: 1.4 },
    pad:    { ...bed, space: .75, brightness: .3, drive: .3, register: .4, articulation: .35, width: .7, level: .5 },
  }),
  section('lift', 8, { role: 'develop', sweep: 2,
    drums:  { density: .7, groove: .6, drive: .68, brightness: .6, articulation: .55, level: .5 },
    bass:   { ...low, weight: .7, register: .4, brightness: .6, drive: .57, articulation: .55, level: .75 },
    melody: { ...hook, density: .6, brightness: .6, width: .6, articulation: .55, sound: 'vibraphone', notes: '0 2 4 ~ 5 4 5@2 0 2 4 ~ 6 5 7@2', level: 1.5 },
    pad:    { ...bed, space: .6, brightness: .6, drive: .57, articulation: .55, width: .7, level: .5 },
    fx:     { riser: 2, level: .6 },
  }),
  section('drop', 8, { role: 'climax', key: 'Eb:major', progression: 'I V7 vi IV', sweep: 2,
    drums:   { density: .9, drive: .95, articulation: .8, brightness: .7, level: .4 },
    bass:    { ...low, weight: .9, aggression: .6, density: .75, brightness: .7, drive: .65, articulation: .6, notes: '0 7 0 4', level: .75 },
    melody:  { ...hook, density: .7, width: .6, brightness: .9, articulation: .6, sound: 'piano', notes: '0 2 4 7@2 6 4 2 0 2 4 7@2 5 4@2', level: 2 },
    melody2: { ...bell, notes: '~ ~ 4 ~ ~ ~ 2 ~' },
    pad:     { ...bed, space: .5, brightness: .9, width: .8, drive: .65, articulation: .6, level: .4 },
    fx:      { impact: true, level: .5 },
  }),
  section('outro', 8, { role: 'release', key: 'Eb:major', progression: 'I IV V I',
    drums:  { density: .6, drive: .4, groove: .8, brightness: .05, articulation: .35, variation: .8, space: .9, width: .7, aggression: .15, level: .5 },
    bass:   { ...low, weight: .6, register: .6, brightness: 1, drive: .8, articulation: .7, variation: .7, groove: .7, level: .7 },
    melody: { ...hook, density: .5, width: .6, brightness: 1, articulation: .7, variation: .7, groove: .7, register: .6, sound: 'piano', notes: '7 6 4@2 ~ 2 0@2', level: 1.8 },
    pad:    { ...bed, space: .7, brightness: 1, width: .8, drive: .8, articulation: .7, register: .6, level: .5 },
  }),
])
