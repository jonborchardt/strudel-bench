// porch: an acoustic guitar piece. Steel-string guitar (gm_acoustic_guitar_steel) picks the chords and plays the solos,
// an acoustic bass under it, cajon and shakers for the quiet drums. Five solos: the first two trade, a break, a third
// that breathes, a fourth that climbs, a two-bar pickup alone, and the fifth is the climax.
// The guitars and the bass are raw parts (plain note().s()) so nothing puts a synth filter or attack on a plucked string.
const played = { timingMs: 12, velocity: .1, correlation: 'phrase' };
const kit = { bd: 'cajon:2', sd: 'cajon:6', hh: 'shaker_small:6', oh: 'shaker_large:0' };
const GROOVE = { bd: 'x.......x.x.....', sd: '....x.......x...', hh: 'x.x.x.x.x.x.x.x.', oh: '..............x.' };
const HALF = { bd: 'x.........x.....', sd: '........x.......', hh: 'x..x..x...x..x..' };
const quiet = { sounds: kit, template: GROOVE, articulation: .6, humanize: { ...played, correlation: 'bar' } };
const G = 'gm_acoustic_guitar_steel';
// fingerpicking, one bar per chord: the bass string, then thumb and fingers across the shape
const pick = (chords) => ({ pattern: note('<' + chords + '>').s(G).clip(1.4), level: .32, position: -.35, brightness: .42, space: .6, humanize: { ...played, correlation: 'bar' } });
const Em = '[e3 b3 e4 g4 b3 g4 e4 b3]', A = '[a2 e3 a3 cs4 e4 cs4 a3 e3]', D = '[d3 a3 d4 fs4 a4 fs4 d4 a3]', C = '[c3 g3 c4 e4 g4 e4 c4 g3]';
const bass = (line) => ({ pattern: note('<' + line + '>').s('gm_acoustic_bass').clip(1.2), level: .3, space: .35, humanize: { ...played, correlation: 'bar' } });
const WALK = '[e2 ~ e2 b2] [a1 ~ a1 e2] [c2 ~ c2 g2] [d2 ~ d2 a2]', PUSH = '[e2 e2 e2 b2] [a1 a1 a1 e2] [c2 c2 c2 g2] [d2 d2 d2 a2]';
const DRIVE = '[e2 e2 e2 e2 e2 e2 b2 b2] [a1 a1 a1 a1 a1 a1 e2 e2] [c2 c2 c2 c2 c2 c2 g2 g2] [d2 d2 d2 d2 d2 d2 a2 a2]';
const lead = { sound: G, register: .5, brightness: .8, level: 1.7, space: .4, humanize: played };
const LIFT = 'i IV bVI VII';

song({ cps: .52, key: 'E:dorian', seed: 11, kit: 'RolandR8', visual: 'ink', packs: ['rooms'], room: { ir: 'room', size: .9 } }, [
  section('intro', 4, { role: 'establish', progression: 'i IV i VII',
    raw:    pick([Em, A, Em, D].join(' ')),
  }),
  section('verse', 8, { role: 'develop', progression: 'i IV i VII',
    drums:  { ...quiet, density: .55, level: .28 },
    raw:    bass('[e2 ~ e2 b2] [a1 ~ a1 e2] [e2 ~ e2 b2] [d2 ~ d2 a2]'),
    raw2:   pick([Em, A, Em, D].join(' ')),
    melody: { ...lead, phrase: 2, follow: true, velocity: '.85 1 .9 1 .8 1 .9 .95', notes: '0 ~ 2 3 4@2 ~ 3 2 0 ~ 6 4@2 2 0' },
  }),
  section('solo', 8, { role: 'develop', progression: LIFT,
    drums:  { ...quiet, density: .6, level: .3, variation: .2 },
    raw:    bass(WALK),
    raw2:   pick([Em, A, C, D].join(' ')),
    // one eight-bar line: bar per bracket, runs as inner brackets, degrees past 7 climb the next octave (7 and 14 are the root)
    melody: { ...lead, phrase: 8, velocity: '.9 1 .85 1 .9 1 .95 1',
              notes: '[0 2 4 [5 4] 7@2 ~ 4] [6 4 [3 2] 0@2 ~ [0 2] 3] [4 [4 5] 7 [7 9] 11@2 [9 7] 4] [[7 6 5 4] [3 2 0 2] 3@2 4 ~ ~] [[0 2 3 4] [5 7 9 11] 12@3 [11 9]] [[11 9 7 9] 11@2 [12 11 9 7] ~ 7@2] [[7 9 7 5] [4 5 4 2] [0 2 4 7] [9 7 4 2]] [0@3 ~ 7 0@2]' },
  }),
  section('solo2', 8, { role: 'develop', progression: LIFT,
    drums:  { ...quiet, density: .7, level: .32, variation: .35 },
    raw:    bass(PUSH),
    raw2:   pick([Em, A, C, D].join(' ')),
    // the answer: sixteenths from the top, a pedal-point lick on the root, a run to the top note and home
    melody: { ...lead, phrase: 8, brightness: .85, velocity: '.9 1 .9 1 .95 1 .95 1',
              notes: '[[7 9 11 12] [11 9 7 5] [7 9 11 12] [14 12 11 9]] [11@2 [12 11] 9 [7 9 7 5] 4@2] [[4 5 7 9] [11 12 14 12] 11@2 [9 7 5 4]] [7@3 [5 7] 9 [7 5 4 2] 0@2] [[0 2 0 2] [3 4 3 4] [5 7 5 7] [9 11 9 11]] [[12 11 12 14] 14@2 ~ [12 11 9 7] 4] [[7 4 7 9] [7 4 7 11] [7 4 7 12] [7 4 7 14]] [14@2 [12 11] 9 7 [4 2] 0@2]' },
  }),
  section('break', 4, { role: 'breakdown', progression: 'i IV i VII',
    raw:    bass('[e2 ~ ~ ~] [a1 ~ ~ ~] [e2 ~ ~ ~] [d2 ~ ~ b2]'),
    raw2:   pick([Em, A, Em, D].join(' ')),
    // the hook at half speed, a breath before the third solo
    melody: { ...lead, phrase: 4, follow: true, level: 1.3, velocity: '.8 .9 .85 .9', notes: '0@2 ~ 2 3@2 ~ 4 3@2 2 0@2 ~ ~ 4' },
  }),
  section('solo3', 8, { role: 'develop', progression: LIFT,
    drums:  { ...quiet, template: HALF, density: .55, level: .28, variation: .15 },
    raw:    bass(WALK),
    raw2:   pick([Em, A, C, D].join(' ')),
    // the third breathes: rests, held notes and double-stops over a halftime kit, then a pair of runs to hand off
    melody: { ...lead, phrase: 8, brightness: .75, velocity: '.85 1 .8 1 .85 1 .9 .95',
              notes: '[~ 0 [2 3] 4@2 ~ [4 5] 4] [[3 2] 0@2 ~ ~ [0 2] 3@2] [[4,7]@2 ~ [4 5 7] [7,9]@2 ~ 7] [[9 7 5] 4@2 [3 2] 0@3 ~] [~ [7 9] 11@2 [9 7] [9 11] 12@2] [[11 12 11 9] 7@2 ~ [7 9 7 5] 4@2] [[5 4 2 0] [2 4 5 7] [5 4 2 0] [2 4 5 7]] [[9 7] 4@2 [2 0] ~ 0@3]' },
  }),
  section('solo4', 8, { role: 'develop', progression: LIFT,
    drums:  { ...quiet, density: .7, level: .32, variation: .4 },
    raw:    bass(PUSH),
    raw2:   pick([Em, A, C, D].join(' ')),
    // the fourth climbs: sweeps across the chord shapes, a pedal lick that reaches higher each beat, a run that hands off
    melody: { ...lead, phrase: 8, brightness: .85, velocity: '.9 1 .9 1 .95 1 .95 1',
              notes: '[[7 9 11 12] [14 12 11 9] [7 9 11 12] [14 12 11 9]] [[11 12 11 9] [11 12 11 9] 12@2 [14 12 11 9]] [[7 11 14 11] [7 11 14 11] [9 12 14 12] [9 12 14 12]] [[14 12 11 9] [7 5 4 2] 0@2 [0 2 4 5]] [[7 9 7 9] [9 11 9 11] [11 12 11 12] [12 14 12 14]] [14@2 [12 14] 12 [11 12 11 9] 7@2] [[7 4 7 9] [7 4 7 11] [9 5 9 12] [9 5 9 14]] [[12 11 9 7] [5 4 2 0] 0@2 ~ ~]' },
  }),
  section('pickup', 2, { role: 'breakdown', progression: 'i i',
    // two bars of guitar alone: the pickup run into the last solo
    melody: { ...lead, phrase: 2, brightness: .85, level: 1.9, velocity: '.9 1 .95 1', notes: '[~ ~ [0 2 4 5] [7 9 11 12]] [14@3 ~ [12 11 9 7] 4@2]' },
  }),
  section('solo5', 8, { role: 'climax', progression: LIFT,
    drums:  { ...quiet, density: .85, level: .36, variation: .5 },
    raw:    bass(DRIVE),
    raw2:   pick([Em, A, C, D].join(' ')),
    // the fifth goes for it: sixteenths and sextuplets top to bottom, sweeps, tremolo picking up the scale, the high root held
    melody: { ...lead, phrase: 8, brightness: .9, level: 1.9, velocity: '.95 1 .95 1 1 1 1 1',
              notes: '[[9 11 12 14] [12 11 9 7] [9 11 12 14] [12 11 9 7]] [[7 9 11 12 14 12] [11 9 7 5 4 2] [4 5 7 9 11 12] [11 9 7 5 4 2]] [[0 4 7 12] [0 4 7 12] [2 5 9 14] [2 5 9 14]] [[14 12 11 9] [11 9 7 5] [7 5 4 2] [4 2 0 2]] [[7 7 7 7] [9 9 9 9] [11 11 11 11] [12 12 12 12]] [[14 14 14 14] [14 14 14 14] [12 14 12 11] [12 14 12 11]] [[7 9 11 12 14 12] [11 9 7 5 4 2] [7 9 11 12 14 12] [11 9 7 5 4 2]] [[12 11 12 14] 14@4 ~ 7@2]' },
  }),
  section('outro', 4, { role: 'release', progression: 'i IV i i',
    raw:    bass('[e2 ~ ~ ~] [a1 ~ ~ ~] [e2 ~ ~ ~] [e2 ~ ~ ~]'),
    raw2:   pick([Em, A, Em, '[e3 b3 e4 g4 b4@4]'].join(' ')),
  }),
])
