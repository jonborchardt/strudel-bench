// breakwater-mixed: breakwater after the mixing pass, kept next to the original so the two can be A/B'd. Same loop,
// same cuts, same lines; what changed is the mix. Measured as written, the climax had the drums layer as the mix (0.8 dB
// under it, 5% of samples clipping), the break itself 10 dB down, the piano hook 21 dB down, the glockenspiel twin 57 dB
// down (inaudible), and the break, pad and fx all dead centre, each part in its own room. Now: one short room on the
// song with each part's space as its send; the drums layer brought down under the break (the loop is the kit here, the
// layer only adds hats); the bass under the kick, ducked with a written recovery; the marimba and piano up to foreground
// with a phrase-shaped velocity line, a little right; the bell twin a vibraphone (the glockenspiel sample is too quiet
// to place), lower in register, set left; the pad wide, behind and a little left; the riser and impact set back.
// `npm run measure -- songs/breakwater-mixed.strudel breakwater` shows the table; compare with the same on songs/breakwater.strudel.
// shoreline -> swell -> undertow -> surge -> breakwater -> backwash. 52 bars (54.7 cycles: undertow's eight bars
// run at its own slower tempo, so they take longer than eight cycles of the song).
// Axis values are 0..1 with 0.5 = the layer's baseline.

// the break itself: the whole file, two bars, eight equal slices. Sections override slices/pattern/region.
const brk  = { sound: 'loop', bars: 2, slices: 8, pattern: '0 1 2 3 4 5 6 7' };
// the answering voices, each with a place on the stage
const low  = { sound: 'square', register: .25, weight: .75, articulation: .6, brightness: .35, space: .35, duck: 'drums', duckDepth: .35, duckAttack: .12, level: .55 };
const lead = { sound: 'marimba', follow: true, phrase: 2, register: .55, articulation: .45, space: .3, weight: .58, width: .5, position: .15, velocity: '.85 1 .9 1 .8 1 .9 .95', humanize: { timingMs: 12, velocity: .1, correlation: 'phrase' } }; // closer, and played
const bell = { sound: 'vibraphone', follow: true, register: .7, level: .8, space: .8, brightness: .38, weight: .42, position: -.4 }; // farther
const wash = { register: .4, articulation: .15, space: .75, brightness: .3, level: .5, width: .7, position: -.25 };
const under = { duck: 'drums', duckDepth: .15, duckAttack: .2 }; // the pad under the kick, only where there is a kit

// second pass: a generated small room (samples/user/rooms, 0.9 s, 8 ms pre-delay) so the break's attacks stay in front of the reverb; the
// lead humanized; depth by the closer/farther words, not level alone.
song({ bpm: 132, key: 'F:minor', seed: 19, kit: 'RolandTR909', packs: ['demo-pack', 'rooms'], room: { ir: 'room', size: .9, damping: 6000 } }, [

  // the loop as recorded, filtered and far off: the break is the whole arrangement, and nothing answers it yet.
  section('shoreline', 8, { role: 'establish', progression: 'i',
    sample: { ...brk, level: .55, brightness: .3, weight: .4, space: .75, width: .4 },
    pad:    { ...wash, density: .25, space: .95, brightness: .15 },
  }),

  // halves: bar two of the loop swaps for a repeat of bar one every other pass, so the break starts to stutter.
  // The bass enters on the octave leap; the hats of the drums layer sit under the loop rather than over it.
  section('swell', 8, { role: 'develop', progression: 'i VI',
    sample: { ...brk, slices: 2, pattern: '0 <1 0>', level: .8, brightness: .5, weight: .55, space: .5, width: .5 },
    drums:  { template: 'minimal', density: .35, brightness: .25, space: .45, level: .35 },
    bass:   { ...low, density: .8, notes: '0 ~ ~ 0 ~ 7 ~ 3', drive: .4 },
    pad:    { ...wash, ...under, density: .4, space: .8 },
  }),

  // the undertow: only the second bar of the file (begin .5), quartered, at three quarters of the tempo. Slower cps
  // means a slower playback rate, so the break drops in pitch and gets heavy - the one section with its own bpm.
  section('undertow', 8, { role: 'develop', bpm: 99, progression: 'i VII VI VII',
    sample: { ...brk, begin: .5, end: 1, bars: 1, slices: 4, pattern: '0 1 [2 2] 3', level: .9, brightness: .35, weight: .85, space: .55, width: .6 },
    drums:  { template: 'halftime', density: .4, weight: .7, brightness: .2, articulation: .3, space: .55, level: .4 },
    bass:   { ...low, density: .8, notes: '0 ~ ~ ~ 3 ~ 0 ~', weight: .9, register: .15, brightness: .25 },
    melody: { ...lead, density: .45, notes: '0 ~ 3 ~ 2 ~ 0@2 ~ 3 ~ 4 ~ 7 4@2', brightness: .4, space: .6, level: 1.4 },
    pad:    { ...wash, ...under, density: .35, brightness: .2, space: .85 },
  }),

  // back to tempo and up a gear: quarters of the loop, one of them doubled, the last alternating - the break is being
  // played now, not played back. Riser into the climax; the marimba answers the undertow question and lands home.
  section('surge', 8, { role: 'develop', progression: 'i VI VII',
    sample: { ...brk, slices: 4, pattern: '0 1 [2 0] <3 2>', level: .95, brightness: .65, weight: .6, space: .4, width: .6 },
    drums:  { template: 'breaks', density: .62, drive: .6, brightness: .55, articulation: .6, level: .4 },
    bass:   { ...low, density: .8, notes: '0 ~ 0 7 ~ 3 ~ 0', drive: .6, brightness: .5 },
    melody: { ...lead, density: .6, notes: '0 ~ 3 2 ~ 4 3@2 ~ 5 4 3 ~ 2 0@2', brightness: .6, level: 1.6 },
    pad:    { ...wash, ...under, density: .5, brightness: .45, space: .6 },
    fx:     { riser: 4, level: .6 },
  }),

  // the climax, and the reason for the break points: the file is two bars, so 1/16 of it is one eighth note. The
  // list cuts at .0625 .125 .1875 .25 .5, giving slice 0 = the first kick, 1 = the gap after it, 2 = the first snare,
  // 3 = the gap after that and 4 = the second half of bar one, its kick and snare together. (The last break at .5
  // leaves bar two as slice 5; this chop never reaches for it - bar two is what the other sections play.)
  // So the pattern can play a real groove out of order: kick on one, snare on two, snare and kick on the backbeat.
  // Every hit sits on an eighth-of-a-bar step and slice 4 on a half-bar step - each step is exactly as long as the
  // slice is, so stretch only locks the fit and every hit still plays at its own pitch (speed .275, as everywhere
  // else in the song). stretch is the timing, not a transposition.
  section('breakwater', 12, { role: 'climax', progression: 'i VI III VII',
    sample:  { ...brk, slices: [.0625, .125, .1875, .25, .5], pattern: '[0 ~] [2 0] [~ 0] [2 <0 2>] [0 ~] [2 0] 4@2', stretch: true,
               level: 1, brightness: .8, weight: .8, space: .4, width: .6 },
    drums:   { template: 'breaks', density: .9, drive: .85, articulation: .8, brightness: .7, weight: .6, variation: .35, level: .35 },
    bass:    { ...low, density: .8, notes: '0 0 7 ~ 5 ~ 3 0', weight: .9, drive: .7, aggression: .55, brightness: .6 },
    melody:  { ...lead, sound: 'piano', density: .65, notes: '0 3 ~ 5 4 3@2 ~ 7 ~ 5 4 3 ~ 0@2', brightness: .8, width: .6, level: 2 },
    melody2: { ...bell, notes: '~ ~ 7 ~ ~ ~ 5 ~', density: .4 },
    pad:     { ...wash, ...under, density: .6, brightness: .6, width: .8, space: .5, level: .4 },
    fx:      { impact: true, level: .5 },
  }),

  // the tide out: the same eight slices, all but two of them deleted, wide open room. Nothing answers but the pad
  // and one falling marimba phrase that ends on the root.
  section('backwash', 8, { role: 'release', progression: 'VI VII i',
    sample: { ...brk, pattern: '0 ~ ~ ~ 4 ~ ~ ~', level: .7, brightness: .35, weight: .5, space: .85, width: .8 },
    melody: { ...lead, density: .4, phrase: 1, notes: '0 ~ ~ 3 2 ~ 0@2', brightness: .35, space: .8, level: 1.2 },
    pad:    { ...wash, density: .35, space: .95, brightness: .2, level: .55 },
  }),

])
