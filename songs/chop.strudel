// chop: the sample part. samples/user/demo-pack/loop.wav is a generated two-bar drum loop (CC0). The part cuts the
// whole file (begin 0, end 1) into 8 slices standing for 2 bars at the song tempo and plays them in the order
// `pattern` writes: slice indices in mini-notation, spanning the sample's bars, so '0 1 2 3 4 5 6 7' is the loop as
// recorded. `stretch: true` fits each slice to its step; without it a slice keeps its own length at the fitted speed.
song({ cps: .5, key: 'C:minor', seed: 7, kit: 'RolandTR909', packs: ['demo-pack'] }, [
  section('loop', 4, { role: 'establish',
    sample: { sound: 'loop', bars: 2, slices: 8, pattern: '0 1 2 3 4 5 6 7' },
  }),
  section('chop', 4, { role: 'climax', progression: 'i VI III VII',
    sample: { sound: 'loop', bars: 2, slices: 8, pattern: '0 1 0 3 4 [6 7] 7 6', stretch: true, space: .6 },
    bass:   { weight: .6, density: .8, notes: '0 ~ 0 7 ~ 4 3 ~' },
  }),
])
