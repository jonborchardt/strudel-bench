// nocturne: dark, sleek pop-funk at 117 BPM. Drums alone, then the bass arrives and
// becomes the hook. Choruses open the same machine up; verses pull the width back.
// intro → arrive → verse → chorus → verse2 → chorus2 → breakdown → rebuild → final → outro. 62 cycles.
// Axis values are 0..1 with 0.5 = the layer's baseline. Hypnotic: variation low, groove nearly straight.
const drums = { density: .55, drive: .7, articulation: .8, space: .25, groove: .45, variation: .2, organicness: .4, brightness: .45 };
const bass = { weight: .75, density: .8, drive: .3, articulation: .75, register: .35, brightness: .4, space: .2, variation: .1, groove: .45, sound: 'square', notes: '0 ~ 0 7 ~ 4 3 ~' };
const melody = { density: .2, articulation: .9, register: .45, brightness: .4, space: .3, width: .4, variation: .2, sound: 'clavisynth', follow: true, phrase: 2, notes: '~ 0 2 ~ 3 ~ 2 0 ~ 0 2 ~ 4@2 3 0' };
const answer = { notes: '~ ~ 7 ~ ~ 5 ~ ~', sound: 'vibraphone', register: .7, level: .5, follow: true, space: .6, width: .7 };
const pad = { density: .2, articulation: .15, brightness: .25, weight: .35, space: .55, width: .35 };

song({ cps: .4875, key: 'E:minor', seed: 11, kit: 'LinnLM2' }, [
  section('intro', 2, { role: 'establish',
    drums: { ...drums },
  }),
  section('arrive', 4, { role: 'establish',
    drums:  { ...drums },
    bass:   { ...bass },
    melody: { ...melody },
  }),
  section('verse', 8, { role: 'develop', progression: 'i VI VII',
    drums:  { ...drums, density: .6, variation: .25 },
    bass:   { ...bass },
    melody: { ...melody, density: .4, articulation: .8, register: .4, width: .3, variation: .3 },
    pad:    { ...pad },
  }),
  section('chorus', 8, { role: 'climax', progression: 'i VI III VII',
    drums:  { ...drums, density: .75, drive: .75, articulation: .75, space: .3, variation: .3, brightness: .6, width: .65 },
    bass:   { ...bass, weight: .8, drive: .35, brightness: .45 },
    melody: { ...melody, density: .6, articulation: .75, register: .5, brightness: .6, space: .4, width: .65, variation: .3 },
    melody2: { ...answer },
    pad:    { ...pad, density: .6, articulation: .3, brightness: .5, weight: .5, space: .65, width: .85, arp: 'up' },
  }),
  section('verse2', 8, { role: 'develop', progression: 'i VI VII',
    drums:  { ...drums, density: .6, variation: .5 },
    bass:   { ...bass, variation: .2 },
    melody: { ...melody, density: .45, articulation: .8, register: .4, width: .3, variation: .5 },
    pad:    { ...pad, density: .3, brightness: sine.range(.2, .4).slow(8) },
  }),
  section('chorus2', 8, { role: 'climax', progression: 'i VI III VII',
    drums:  { ...drums, density: .8, drive: .75, articulation: .75, space: .3, variation: .55, brightness: .65, width: .7 },
    bass:   { ...bass, weight: .8, drive: .35, brightness: .45, variation: .2 },
    melody: { ...melody, density: .65, articulation: .75, register: .5, brightness: .65, space: .4, width: .7, variation: .45 },
    melody2: { ...answer },
    pad:    { ...pad, density: .7, articulation: .3, brightness: .55, weight: .5, space: .65, width: .85, arp: 'up' },
  }),
  section('breakdown', 4, { role: 'develop',
    drums: { ...drums, density: .35, space: .45, brightness: .4 },
    bass:  { ...bass, weight: .65, density: .45, brightness: .35, space: .3 },
    pad:   { ...pad, articulation: .1, brightness: .2, weight: .3, space: .8, width: .4 },
  }),
  section('rebuild', 4, { role: 'develop',
    drums:  { ...drums, space: .3, variation: .3 },
    bass:   { ...bass },
    melody: { ...melody, density: .3, articulation: .85, brightness: saw.range(.35, .6).slow(4), variation: .3 },
    pad:    { ...pad, density: .3, brightness: .3, space: .6, width: .5 },
    fx:     { riser: 2 },
  }),
  section('final', 8, { role: 'climax', progression: 'i VI III VII',
    drums:  { ...drums, density: .85, drive: .8, articulation: .75, space: .3, variation: .55, brightness: .65, width: .7 },
    bass:   { ...bass, weight: .8, density: .85, drive: .35, brightness: .5, variation: .25 },
    melody: { ...melody, density: .7, articulation: .75, register: .5, brightness: .65, space: .4, width: .7, variation: .6 },
    melody2: { ...answer, level: .6 },
    pad:    { ...pad, density: .7, articulation: .3, brightness: .55, weight: .5, space: .65, width: .85, arp: 'up' },
    fx:     { impact: true },
  }),
  section('outro', 8, { role: 'release',
    drums:  { ...drums, density: .6, drive: .75, space: .3, variation: .3, brightness: .5 },
    bass:   { ...bass },
    melody: { ...melody, density: .3, articulation: .8, brightness: saw.range(.6, .3).slow(8), space: .5, width: .5, variation: .3 },
    pad:    { ...pad, density: .3, articulation: .2, brightness: saw.range(.5, .2).slow(8), weight: .3, space: .75, width: .7 },
  }),
])
